<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp" />
            <solid android:color="#FF5722" /> <!-- Background color when clicked -->
            <stroke android:width="1dp" android:color="#FF5722" /> <!-- Border color when clicked -->
        </shape>
    </item>
    <item>
        <shape>
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp" />
            <solid android:color="#FFFFFF" /> <!-- Default background color -->
            <stroke android:width="1dp" android:color="#FF5722" /> <!-- Default border color -->
        </shape>
    </item>
</selector>
